{
  "plugin": "org.smartide.plugin.java",
  "run": "java Main.java",
  "intelligence": {
    ".json": {
      "enabled": true,
      "run": "vscode-json-language-server --stdio"
    },
    ".java": {
      "enabled": false,
      "run": "jdtls"
    },
    ".sh": {
      "enabled": true,
      "run": "bash-language-server start"
    },
    ".swift": {
      "enabled": false,
      "run": "sourcekit-lsp"
    },
    ".yml": {
      "enabled": true,
      "run": "yaml-language-server --stdio"
    }
  }
}